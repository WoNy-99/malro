<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/app_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 왼쪽 뒤로가기 버튼 -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/topbar_backarrow"
            android:background="@null"
            android:contentDescription="뒤로가기"
            android:padding="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 타이틀 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="학습"

            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 프로필 이미지 -->
        <ImageView
            android:id="@+id/avatar_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/image0"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="로그아웃" />/>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:fontFamily="@font/nanum_gothic_bold"
        android:text="학습하기"
        android:textColor="#000000"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_bar" />

    <!-- 언어 선택 스피너 -->
    <Spinner
        android:id="@+id/split_button_lang"
        android:layout_width="142dp"
        android:layout_height="59dp"
        android:layout_marginTop="73dp"
        android:background="@drawable/split_button_background"
        android:spinnerMode="dropdown"
        android:entries="@array/language_array"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_text"/>

    <!-- 수준 선택 스피너 -->
    <Spinner
        android:id="@+id/split_button_lev"
        android:layout_width="142dp"
        android:layout_height="59dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/split_button_background"
        android:spinnerMode="dropdown"
        android:entries="@array/level_array"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/split_button_lang"/>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/extended_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="105dp"
        android:backgroundTint="@color/primary_container"
        android:text="시작!"
        android:textColor="@color/on_primary_container"
        app:icon="@drawable/ic_start"
        app:iconTint="@color/on_primary_container"
        app:layout_constraintBottom_toTopOf="@id/navigation_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 하단 네비게이션 바 -->
    <LinearLayout
        android:id="@+id/navigation_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="#F3EDF7"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 학습 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_study"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="학습"
            android:textColor="#625B71"
            android:textSize="12sp"
            app:icon="@drawable/ic_learn_active"
            app:iconGravity="textTop"
            app:iconTint="#625B71"
            app:iconSize="28dp"
            app:iconPadding="0dp"/>

        <!-- 아카이브 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_archive"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="아카이브"
            android:textColor="#49454F"
            android:textSize="12sp"
            app:icon="@drawable/ic_main_inactive"
            app:iconGravity="textTop"
            app:iconTint="#49454F"
            app:iconSize="28dp"
            app:iconPadding="0dp"/>

        <!-- 번역 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_translate"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="번역"
            android:textColor="#49454F"
            android:textSize="12sp"
            app:icon="@drawable/ic_translate_inactive"
            app:iconGravity="textTop"
            app:iconTint="#49454F"
            app:iconSize="28dp"
            app:iconPadding="0dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
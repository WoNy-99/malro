<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 상단 앱바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/app_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 왼쪽 뒤로가기 버튼 -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/topbar_backarrow"
            android:background="@null"
            android:contentDescription="뒤로가기"
            android:padding="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 타이틀 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 번역"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 프로필 이미지 -->
        <ImageView
            android:id="@+id/avatar_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/image0"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="로그아웃" />/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ScrollView: 스크롤 본문 -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/app_bar"
        app:layout_constraintBottom_toTopOf="@id/navigation_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- 입력 영역 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spinnerSourceLanguage"
                    android:layout_width="63dp"
                    android:layout_height="45dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/langroup"
                    android:contentDescription="Source Language Selector"
                    android:entries="@array/language_list"
                    android:spinnerMode="dropdown" />

                <!-- EditText + 마이크 버튼 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <EditText
                        android:id="@+id/inputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/dialog"
                        android:gravity="top|start"
                        android:hint="번역할 문장을 입력하세요"
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textSize="16sp" />

                    <!-- 마이크 버튼 -->
                    <ImageButton
                        android:id="@+id/btnVoiceInput"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:background="@drawable/ic_mic"
                        android:contentDescription="음성 입력" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/btnPlayInputAudio"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/volume"
                    android:contentDescription="Play Input Audio" />
            </LinearLayout>

            <!-- 화살표 이미지 -->
            <ImageButton
                android:id="@+id/btnSwitchLanguages"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/arrow"
                android:background="@null"
                android:contentDescription="Switch Languages"
                android:layout_marginBottom="16dp" />

            <!-- 출력 영역 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <Spinner
                    android:id="@+id/spinnerTargetLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/langroup"
                    android:entries="@array/language_list"
                    android:spinnerMode="dropdown"
                    android:contentDescription="Target Language Selector" />

                <TextView
                    android:id="@+id/textTranslatedOutput"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:text="결과"
                    android:background="@drawable/dialog"
                    android:textSize="16sp"
                    android:textColor="@color/primary_text_color"
                    android:padding="12dp" />

                <ImageButton
                    android:id="@+id/btnPlayOutputAudio"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Play Output Audio"
                    android:src="@drawable/volume" />
            </LinearLayout>

            <!-- 🔹 번역하기 & 학습하기 버튼 그룹 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                    android:id="@+id/btnTranslate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/secondary_container"
                    android:text="번역하기"
                    android:textColor="@color/on_secondary_container"
                    app:icon="@drawable/ic_translate_inactive"
                    app:iconTint="@color/on_secondary_container" />

                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                    android:id="@+id/extended_fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/secondary_container"
                    android:text="학습하기"
                    android:textColor="@color/on_primary_container"
                    app:icon="@drawable/ic_start"
                    app:iconTint="@color/on_primary_container" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 하단 네비게이션 바 -->
    <LinearLayout
        android:id="@+id/navigation_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="#F3EDF7"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 학습 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_study"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="학습"
            android:textColor="#625B71"
            android:textSize="12sp"
            app:icon="@drawable/ic_main_inactive"
            app:iconSize="25dp"
            app:iconGravity="textTop"
            app:iconTint="#625B71" />

        <!-- 아카이브 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_archive"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="아카이브"
            android:textColor="#49454F"
            android:textSize="12sp"
            app:icon="@drawable/ic_main_inactive"
            app:iconSize="25dp"
            app:iconGravity="textTop"
            app:iconTint="#49454F" />

        <!-- 번역 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_translate"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="번역"
            android:textColor="#625B71"
            android:textSize="12sp"
            app:icon="@drawable/ic_learn_active"
            app:iconGravity="textTop"
            app:iconTint="#625B71"
            app:iconSize="28dp"
            app:iconPadding="0dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
